export BUILD_CONTEXT="./sox"
export BUILD_ARGS="UV_PYTHON=$(<.python-version)"
export DOCKERFILE="./sox/Dockerfile"
export DOCKER_METADATA_ANNOTATIONS_LEVELS="manifest"
export GITHUB_EVENT_NAME="workflow_dispatch"
export GITHUB_REF_NAME="local"
export GITHUB_REF_TYPE="branch"
export GITHUB_REPOSITORY="br3ndonland/sox"
export GITHUB_RUN_ATTEMPT="1"
export GITHUB_RUN_ID="local"
export GITHUB_SERVER_URL="https://github.com"
export IMAGE_NAME="local/br3ndonland/sox"
export LOAD="true"
export OCI_DESCRIPTION="Docker container image for audio analysis and conversion with Sound eXchange (SoX)"
export OCI_LICENSES="CC0-1.0"
export OCI_URL="https://github.com/br3ndonland/sox/pkgs/container/sox"
export PLATFORMS="linux/amd64"
export PROVENANCE="false"
export TAG_LATEST="true"
